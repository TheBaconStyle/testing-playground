{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf build && ncc build ./src/main.ts -o build -m -e pg-native -e cloudflare:sockets",
