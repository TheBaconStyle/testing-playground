{
  "name": "db",
  "version": "1.0.0",
  "exports": {
    ".": {
      "node": "./lib/db.js",
      "types": "./lib/db.d.ts"
    },
    "./schema": {
      "node": "./lib/schema.js",
      "types": "./lib/schema.d.ts"
    }
  },
  "scripts": {
    "generate": "dotenvx run -- drizzle-kit generate",
    "migrate": "dotenvx run -- drizzle-kit migrate",
    "drop": "dotenvx run -- drizzle-kit drop",
    "push": "dotenvx run -- drizzle-kit push",
    "pull": "dotenvx run -- drizzle-kit pull",
    "build": "rimraf lib && tsc",
    "build:migration": "ncc build ./src/migration.ts -o build -m",
    "dev": "tsc --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "drizzle-orm": "^0.43.1",
    "pg": "^8.15.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.43.0",
    "@types/pg": "^8.15.1",
    "@vercel/ncc": "^0.38.3",
    "drizzle-kit": "^0.31.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
