{
  "name": "db",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "require": "./lib/db.js",
      "types": "./lib/db.d.ts",
      "default": "./lib/db.js"
    },
    "./schema": {
      "require": "./lib/schema.js",
      "types": "./lib/schema.d.ts",
      "default": "./lib/schema.js"
    }
  },
  "scripts": {
    "generate": "dotenvx run -- drizzle-kit generate",
    "migrate": "dotenvx run -- drizzle-kit migrate",
    "studio": "dotenvx run -- drizzle-kit studio",
    "drop": "dotenvx run -- drizzle-kit drop",
    "push": "dotenvx run -- drizzle-kit push",
    "pull": "dotenvx run -- drizzle-kit pull",
    "build": "rimraf lib && tsc",
    "build:migration": "ncc build ./src/migration.ts -o build -m"
  },
  "license": "UNLICENSED",
  "description": "",
  "dependencies": {
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
