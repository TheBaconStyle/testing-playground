{
  "name": "db",
  "version": "1.0.0",
  "exports": {
    "./source/*": "./src/*.ts",
    "./dist/*": "./lib/*.js"
  },
  "typesVersions": {
    "*": {
      "dist/*": [
        "./lib/*.d.ts"
      ]
    }
  },
  "type": "commonjs",
  "scripts": {
    "generate": "dotenvx run -- drizzle-kit generate",
    "migrate": "dotenvx run -- drizzle-kit migrate",
    "drop": "dotenvx run -- drizzle-kit drop",
    "push": "dotenvx run -- drizzle-kit push",
    "pull": "dotenvx run -- drizzle-kit pull",
    "build": "rimraf lib && tsc",
    "build:migration": "ncc build ./src/migration.ts -o dist -m"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.24.5",
    "@types/pg": "^8.11.13",
    "@vercel/ncc": "^0.38.3",
    "drizzle-kit": "^0.28.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
